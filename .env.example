# Karahan's Studio - Environment Variables Example
# Copy this file to .env and fill in the actual values

# Node Environment
NODE_ENV=development
PORT=3000

# Session Security (generate a random 32+ character string)
SESSION_SECRET=your-random-session-secret-at-least-32-characters-long

# CORS (comma-separated list of allowed origins, leave empty for same-origin)
ALLOWED_ORIGINS=

# Admin Panel
ADMIN_LOGIN_PATH=/panel-giris
ADMIN_IP_ALLOWLIST=

# Email/SMTP Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Karahan's Studio <noreply@karahans.com>

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Firebase Authentication (required)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# WhatsApp API (optional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
